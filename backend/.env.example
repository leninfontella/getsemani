# Valores públicos usados pelo frontend (a publishable key não concede bypass de RLS).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Segredos exclusivos das Supabase Edge Functions. Nunca use prefixo VITE_ nestes valores.
GCS_BUCKET_NAME=YOUR_PRIVATE_GCS_BUCKET
GCS_CLIENT_EMAIL=YOUR_SERVICE_ACCOUNT_EMAIL
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_A_NEW_ROTATED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
